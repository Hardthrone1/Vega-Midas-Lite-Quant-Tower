//@version=6
// MIDAS Regime Filter v1 — canonical regime definition.
// The Python port in midas_regime_slicer.py mirrors this file exactly:
// same inputs, same ER + ADX trend gate, same ATR fast/slow vol split, and
// the same persistBars hysteresis. Keep the two in lockstep.
indicator("MIDAS Regime Filter v1", overlay=true, precision=2)

erLen        = input.int(14, "Efficiency Ratio Length", minval=2)
erTrendMin   = input.float(0.35, "ER: Trending Threshold", minval=0.05, maxval=1.0, step=0.01)
erRangeMax   = input.float(0.20, "ER: Ranging Threshold",  minval=0.01, maxval=1.0, step=0.01)

adxLen       = input.int(14, "ADX Length", minval=2)
adxTrendMin  = input.float(20.0, "ADX: Trending Threshold", minval=5, maxval=50)

atrFastLen   = input.int(14,  "ATR Fast Length")
atrSlowLen   = input.int(100, "ATR Slow Length (baseline)")
volExpandMin = input.float(1.15, "Vol Expansion Ratio (fast/slow)", minval=1.0, step=0.05)
volContractMax = input.float(0.85, "Vol Contraction Ratio (fast/slow)", minval=0.1, step=0.05)

persistBars  = input.int(3, "Hysteresis: Bars Required to Confirm Flip", minval=1, maxval=20)

netChange   = math.abs(close - close[erLen])
pathSum     = math.sum(math.abs(close - close[1]), erLen)
er          = pathSum == 0 ? 0.0 : netChange / pathSum

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

atrFast = ta.atr(atrFastLen)
atrSlow = ta.atr(atrSlowLen)
volRatio = atrSlow == 0 ? 1.0 : atrFast / atrSlow

isTrending = er >= erTrendMin and adx >= adxTrendMin
isRanging  = er <= erRangeMax and adx < adxTrendMin
isExpanding   = volRatio >= volExpandMin
isContracting = volRatio <= volContractMax

rawState = isTrending and isExpanding ? 1 :
           isTrending and isContracting ? 2 :
           isTrending ? 2 :
           isRanging and isExpanding ? 3 :
           isRanging and isContracting ? 4 :
           isRanging ? 4 :
           0

var int confirmedRegime = 0
var int candidateRegime = 0
var int candidateCount  = 0

if rawState == candidateRegime
    candidateCount := candidateCount + 1
else
    candidateRegime := rawState
    candidateCount := 1

if candidateCount >= persistBars and candidateRegime != 0
    confirmedRegime := candidateRegime

regimeLabel = confirmedRegime == 1 ? "TRENDING / EXPANDING" :
              confirmedRegime == 2 ? "TRENDING / QUIET" :
              confirmedRegime == 3 ? "RANGING / VOLATILE" :
              confirmedRegime == 4 ? "RANGING / QUIET" :
              "UNCONFIRMED"

bgColor = confirmedRegime == 1 ? color.new(color.green, 85) :
          confirmedRegime == 2 ? color.new(color.teal, 88) :
          confirmedRegime == 3 ? color.new(color.red, 85) :
          confirmedRegime == 4 ? color.new(color.gray, 90) :
          na

bgcolor(bgColor)

var label regimeTag = na
if barstate.islast
    label.delete(regimeTag)
    regimeTag := label.new(bar_index, high, regimeLabel,
                 style=label.style_label_down, color=bgColor, textcolor=color.white, size=size.normal)

var table dbg = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 70))
if barstate.islast
    table.cell(dbg, 0, 0, "ER",       text_color=color.white)
    table.cell(dbg, 1, 0, str.tostring(er, "#.###"), text_color=color.white)
    table.cell(dbg, 0, 1, "ADX",      text_color=color.white)
    table.cell(dbg, 1, 1, str.tostring(adx, "#.##"), text_color=color.white)
    table.cell(dbg, 0, 2, "Vol Ratio",text_color=color.white)
    table.cell(dbg, 1, 2, str.tostring(volRatio, "#.###"), text_color=color.white)
    table.cell(dbg, 0, 3, "Raw State",text_color=color.white)
    table.cell(dbg, 1, 3, str.tostring(rawState), text_color=color.white)
    table.cell(dbg, 0, 4, "Confirmed",text_color=color.white)
    table.cell(dbg, 1, 4, regimeLabel, text_color=color.yellow)

plot(confirmedRegime, title="MIDAS_Regime_Code", display=display.data_window)
plot(er,        title="MIDAS_ER",        display=display.data_window)
plot(adx,       title="MIDAS_ADX",       display=display.data_window)
plot(volRatio,  title="MIDAS_VolRatio",  display=display.data_window)
